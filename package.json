{
  "name": "blokade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BloKade — Kade's 3D design app for 3D printing",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.14",
    "@lezer/javascript": "^1.5.6",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "codemirror": "^6.0.2",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.186.1",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.9.1",
